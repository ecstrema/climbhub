{
  "name": "@climbhub/reverse-geocoding-data",
  "version": "1.0.0",
  "private": true,
  "description": "Boundaries of the regions used to reverse geocode the climbing places",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    },
    "./shared": {
      "import": "./src/shared.ts",
      "types": "./src/shared.ts"
    }
  },
  "scripts": {
    "build": "bun run src/main.ts",
    "check-size": "bun run tools/check-boundary-size.ts",
    "import": "bun run import/main.ts",
    "region-names": "bun run tools/region-names.ts"
  },
  "devDependencies": {
    "@climbhub/common": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "osmtogeojson": "catalog:",
    "typescript": "catalog:"
  }
}
