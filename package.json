{
  "name": "climbhub monorepo",
  "private": true,
  "workspaces": {
    "catalog": {
      "@turf/boolean-point-in-polygon": "^7.3.5",
      "@types/bun": "latest",
      "@types/js-yaml": "^4.0.9",
      "@types/node": "^24.13.0",
      "@types/geojson": "7946.0.16",
      "geojson": "^0.5.0",
      "js-yaml": "^5.2.2",
      "osmtogeojson": "^3.0.0-beta.5",
      "osm-api": "^4.0.0",
      "typescript": "^7.0.2",
      "vite": "^8.1.5"
    },
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "cd packages/app && bun run dev",
    "preview": "cd packages/app && bun run preview",
    "build": "cd packages/app && bun run build",
    "build:reverse-geocoding-data": "cd packages/reverse-geocoding-data && bun run build",
    "build:@climbhub/climbing-data-gen": "cd packages/climbing-data-gen && bun run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@climbhub/common": "workspace:*",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.81.0"
  }
}
