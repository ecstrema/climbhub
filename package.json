{
  "name": "climbhub-monorepo",
  "private": true,
  "workspaces": {
    "catalog": {
      "@turf/boolean-point-in-polygon": "^7.4.0",
      "@types/bun": "latest",
      "@types/node": "^24.19.2",
      "@types/geojson": "7946.0.16",
      "geojson": "^0.5.0",
      "osmtogeojson": "^3.0.0-beta.5",
      "osm-api": "^4.0.1",
      "typescript": "^7.0.2",
      "vite": "^8.3.5",
      "oxlint": "^1.90.0",
      "oxfmt": "^0.60.0"
    },
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "cd packages/app && bun run dev",
    "preview": "cd packages/app && bun run preview",
    "build": "cd packages/app && bun run build",
    "build:reverse-geocoding-data": "cd packages/reverse-geocoding-data && bun run build",
    "build:climbing-data-gen": "cd packages/climbing-data-gen && bun run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@climbhub/common": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  }
}
